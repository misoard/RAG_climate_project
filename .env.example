# Copy to .env and fill in. .env is git-ignored; only this example is tracked.

# Required for any live model call (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Model slugs behind the registry aliases in src/app/config.py.
# Swapping a model is an env change, not a code edit.
FAST_MODEL=openrouter/openai/gpt-4o-mini
SMART_MODEL=openrouter/anthropic/claude-sonnet-4.6
